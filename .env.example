# Copy to .env.local. Both developers use identical values in the shared block.
# SIM_KEY is the world.

# Shared

# Team name is the join code. Same name returns the same key and world.
#   curl -s https://sim.animahacks.com/api/keys -H 'Content-Type: application/json' \
#     -d '{"teamName":"<our team name>"}' | jq -r .apiKey
SIM_ORIGIN=https://sim.animahacks.com
SIM_KEY=sim_xxxxxxxxxxxxxxxx

# From the sheet of individual API code URLs shared on Discord.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# One shared Convex dev deployment. Dev A runs `pnpm exec convex dev` first.
CONVEX_DEPLOYMENT=dev:xxxxxxxx
VITE_CONVEX_URL=https://xxxxxxxx.convex.cloud

# Browser. Scope these in the Vapi dashboard.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=

# Server only. Never prefixed VITE_.
# Set these on the Convex deployment, not just here:
#   pnpm exec convex env set OPENAI_API_KEY sk-...
#   pnpm exec convex env set SIM_KEY sim-...
#   pnpm exec convex env set SIM_ORIGIN https://sim.animahacks.com
#   pnpm exec convex env set VAPI_PRIVATE_KEY ...
VAPI_PRIVATE_KEY=

# The voice path reads all four from the deployment. See docs/voice-setup.md.
# VAPI_ASSISTANT_ID is the same id as VITE_VAPI_ASSISTANT_ID above; server
# variables cannot carry the VITE_ prefix, so it is set twice.
VAPI_ASSISTANT_ID=
# Vapi's id for the imported Twilio number, a UUID, not the number itself.
VAPI_PHONE_NUMBER_ID=
# The number the demo call rings, in E.164.
DEMO_PHONE_NUMBER=
# Optional. Matches the secret header on the assistant's server URL.
VAPI_SERVER_SECRET=

# Optional
# EDQM Standard Terms covers dose forms and routes, not drug names.
# Register at edqm.eu/register. Skip if the emailed password has not arrived by 16:00.
EDQM_USERNAME=
EDQM_API_KEY=

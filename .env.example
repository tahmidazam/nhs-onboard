# ---------------------------------------------------------------------------
# NHS Onboard — environment
#
# Copy to .env.local. BOTH DEVELOPERS MUST USE IDENTICAL VALUES for everything
# in the "shared" block — especially SIM_KEY, which *is* the world. Different
# keys mean different 50,000-patient worlds and you will debug ghosts.
#
# Fastest way to sync: one dev fills this in, then pastes the file into Discord.
# ---------------------------------------------------------------------------

# --- shared: identical on both laptops -------------------------------------

# The sim. Team name is the join code — same name returns the same key + world.
#   curl -s https://sim.animahacks.com/api/keys -H 'Content-Type: application/json' \
#     -d '{"teamName":"<our team name>"}' | jq -r .apiKey
SIM_ORIGIN=https://sim.animahacks.com
SIM_KEY=sim_xxxxxxxxxxxxxxxx

# From the sheet of individual API code URLs shared on Discord.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# One SHARED Convex dev deployment so Dev A's ingested patients are visible to
# Dev B's engine. Dev A runs `npx convex dev` first, then shares both lines.
CONVEX_DEPLOYMENT=dev:xxxxxxxx
VITE_CONVEX_URL=https://xxxxxxxx.convex.cloud

# --- browser: safe to expose, scoped in the Vapi dashboard ------------------
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=

# --- server only: never prefixed VITE_, never committed ---------------------
# Set these on the Convex deployment, not just here:
#   npx convex env set OPENAI_API_KEY sk-...
#   npx convex env set SIM_KEY sim-...
#   npx convex env set SIM_ORIGIN https://sim.animahacks.com
#   npx convex env set VAPI_PRIVATE_KEY ...
VAPI_PRIVATE_KEY=

# --- optional, off the critical path ---------------------------------------
# EDQM Standard Terms (dose forms / routes in 35 languages — no Bengali/Hindi).
# Register free at edqm.eu/register; password arrives by email. If it hasn't
# landed by 16:00, skip it — it never maps drug names, only dose forms.
EDQM_USERNAME=
EDQM_API_KEY=
